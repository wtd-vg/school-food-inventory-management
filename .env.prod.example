# Mẫu biến môi trường production (SF38).
# Trên máy chủ: cp .env.prod.example .env.prod && chmod 600 .env.prod rồi điền giá trị thật.
# KHÔNG commit .env.prod. Không dùng dấu cách quanh dấu "=".

# PostgreSQL. Tạo mật khẩu: openssl rand -hex 24
POSTGRES_DB=schoolfood
POSTGRES_USER=schoolfood
POSTGRES_PASSWORD=

# Django. Tạo SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=schoolfoodusth.store
CSRF_TRUSTED_ORIGINS=https://schoolfoodusth.store
WEB_CONCURRENCY=3

# HSTS bắt đầu 1 giờ; tăng lên 31536000 khi HTTPS đã chạy ổn định.
SECURE_HSTS_SECONDS=3600

# BE-10: chỉ tin X-Real-IP (nginx đặt từ CF-Connecting-IP) vì backend không publish cổng.
TRUST_PROXY_IP=true
# Phiên: hết hạn sau 30 phút không thao tác, tối đa 12 giờ kể từ lúc đăng nhập.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200

# BE-04: khóa mã hóa email phụ huynh, BẮT BUỘC khi DEBUG=False.
# Chạy npm run ec2:genkeys để xem lệnh tạo trong container backend (lệnh chỉ in hướng dẫn, không in khóa).
# Fernet: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# HMAC: python -c "import secrets;print(secrets.token_hex(32))"
# Cất khóa NGOÀI server. Xoay Fernet: thêm khóa mới lên đầu, phân cách bằng dấu phẩy.
FIELD_ENCRYPTION_KEYS=
CONTACT_HASH_KEY=

# BE-08: email thực đơn. dry_run = chỉ ghi nhật ký, không gửi thư thật; đổi sang smtp khi trường duyệt.
# Gmail riêng của trường + App Password 16 ký tự (không dùng mật khẩu đăng nhập). Chuyển SES: đổi
# EMAIL_HOST/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD/DEFAULT_FROM_EMAIL, xem docs/SECURITY.md.
EMAIL_MODE=dry_run
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="SchoolFood <dien-email-gui@example.invalid>"
# Chừa khoảng trống so với giới hạn Gmail khoảng 500 thư/ngày.
EMAIL_DAILY_LIMIT=450
# Giờ gửi theo giờ Việt Nam (HH:MM); service scheduler gửi bù nếu khởi động lại trễ.
MENU_SEND_TIME=06:30
# SF74: mặc định không tự gửi; Quản lý bấm "Gửi thư cho phụ huynh". Đặt true để tự gửi lúc MENU_SEND_TIME.
MENU_AUTO_SEND=false
# Dùng để tạo link hủy nhận trong thư.
PUBLIC_BASE_URL=https://schoolfoodusth.store
SCHOOL_NAME="Điền tên trường"

# Token của Cloudflare Tunnel "schoolfood-ec2" (chuỗi sau --token trên dashboard).
TUNNEL_TOKEN=
